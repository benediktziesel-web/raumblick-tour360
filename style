  :root{
    --ink:#1c2521;
    --paper:#edeae2;
    --paper-warm:#e4e0d5;
    --white:#ffffff;
    --brass:#a9793e;
    --brass-soft:#c9a06b;
    --slate:#5c6b66;
    --line: rgba(28,37,33,0.16);
    --maxw: 1100px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Newsreader', serif;
    font-weight:500;
    margin:0;
    letter-spacing:0.001em;
  }
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:var(--maxw); margin:0 auto; padding:0 28px;}

  /* ---- floorplan line motif (decorative, used once) ---- */
  .plan-lines{
    position:absolute; inset:0; pointer-events:none; overflow:hidden;
  }
  .plan-lines svg{width:100%; height:100%; display:block;}

  /* ---- header ---- */
  header{
    position:sticky; top:0; z-index:20;
    background:rgba(237,234,226,0.92);
    backdrop-filter: blur(6px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:18px 28px; max-width:var(--maxw); margin:0 auto;
  }
  .wordmark{
    font-family:'Newsreader', serif;
    font-size:1.28rem;
    font-weight:500;
  }
  .wordmark .accent{color:var(--brass);}
  nav ul{
    list-style:none; display:flex; gap:30px; margin:0; padding:0;
  }
  nav a{
    text-decoration:none; font-size:0.95rem; color:var(--ink);
    border-bottom:1px solid transparent;
  }
  nav a:hover{border-bottom-color:var(--brass);}
  .nav-cta{
    display:inline-block; padding:9px 18px;
    background:var(--ink); color:var(--paper);
    text-decoration:none; font-size:0.92rem;
    border-radius:2px;
  }
  .menu-btn{display:none; background:none; border:none; font-size:1.6rem; cursor:pointer; color:var(--ink);}

  /* ---- hero ---- */
  .hero{
    position:relative;
    padding:100px 0 90px;
    overflow:hidden;
    border-bottom:1px solid var(--line);
  }
  .hero-inner{
    position:relative; z-index:1;
    display:grid; grid-template-columns: 1.3fr 0.9fr; gap:60px; align-items:end;
  }
  .hero h1{
    font-size:clamp(2.3rem, 4.4vw, 3.6rem);
    line-height:1.12;
    max-width:14ch;
  }
  .hero .lede{
    margin-top:26px;
    font-size:1.08rem;
    color:var(--slate);
    max-width:42ch;
  }
  .hero-actions{display:flex; gap:16px; margin-top:34px; flex-wrap:wrap;}
  .btn-primary{
    background:var(--brass); color:var(--white);
    padding:13px 26px; text-decoration:none; font-size:0.98rem;
    border-radius:2px; font-weight:500;
  }
  .btn-ghost{
    padding:13px 26px; text-decoration:none; font-size:0.98rem;
    border:1px solid var(--ink); color:var(--ink); border-radius:2px;
  }
  .hero-figure{
    border:1px solid var(--line);
    padding:26px;
    background:var(--white);
  }
  .hero-figure .label{
    font-size:0.78rem; letter-spacing:0.02em; color:var(--slate); margin-bottom:14px;
  }
  .hero-figure .big{
    font-family:'Newsreader', serif; font-size:2.6rem; color:var(--brass); line-height:1;
  }
  .hero-figure .cap{color:var(--slate); font-size:0.92rem; margin-top:8px;}
  .hero-figure hr{border:none; border-top:1px solid var(--line); margin:20px 0;}

  /* ---- section basics ---- */
  section{padding:78px 0;}
  .section-head{max-width:60ch; margin-bottom:46px;}
  .section-head .kicker{
    font-size:0.85rem; color:var(--brass); margin-bottom:10px; font-weight:500;
  }
  .section-head h2{font-size:clamp(1.7rem, 2.6vw, 2.3rem); line-height:1.2;}
  .section-head p{color:var(--slate); margin-top:14px; font-size:1.02rem;}

  /* ---- warum ---- */
  .warum{background:var(--white); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
  .warum-grid{
    display:grid; grid-template-columns: repeat(3, 1fr); gap:36px;
  }
  .warum-card h3{font-size:1.15rem; margin-bottom:10px;}
  .warum-card p{color:var(--slate); font-size:0.98rem;}
  .warum-card .mark{
    display:inline-block; width:34px; height:2px; background:var(--brass); margin-bottom:18px;
  }

  /* ---- leistungen ---- */
  .service-block{
    display:grid; grid-template-columns: 0.9fr 1.6fr; gap:44px;
    padding:44px 0; border-top:1px solid var(--line);
  }
  .service-block:last-child{border-bottom:1px solid var(--line);}
  .service-num{font-family:'Newsreader', serif; font-size:1rem; color:var(--brass);}
  .service-head h3{font-size:1.5rem; margin-top:8px;}
  .service-head p{color:var(--slate); margin-top:10px; font-size:0.98rem;}

  table.price{width:100%; border-collapse:collapse; font-size:0.96rem;}
  table.price th{
    text-align:left; font-weight:500; color:var(--slate); font-size:0.82rem;
    padding-bottom:10px; border-bottom:1px solid var(--ink);
  }
  table.price td{
    padding:14px 0; border-bottom:1px solid var(--line); vertical-align:top;
  }
  table.price td.amount{
    text-align:right; font-family:'Newsreader', serif; font-size:1.08rem; white-space:nowrap;
  }
  table.price tr.extra td{color:var(--slate); font-size:0.92rem;}

  .badge-soon{
    display:inline-block; margin-left:10px; font-size:0.72rem;
    border:1px solid var(--brass-soft); color:var(--brass);
    padding:2px 8px; border-radius:20px; vertical-align:middle;
  }

  /* ---- anfahrt ---- */
  .anfahrt{background:var(--white); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
  .anfahrt-inner{display:grid; grid-template-columns: 0.9fr 1.6fr; gap:44px;}
  table.travel{width:100%; border-collapse:collapse; font-size:0.96rem;}
  table.travel th{
    text-align:left; font-weight:500; color:var(--slate); font-size:0.82rem;
    padding-bottom:10px; border-bottom:1px solid var(--ink);
  }
  table.travel td{padding:13px 0; border-bottom:1px solid var(--line);}
  table.travel td.amount{text-align:right; white-space:nowrap;}
  .radius-note{margin-top:18px; font-size:0.9rem; color:var(--slate);}

  /* ---- über mich ---- */
  .about-inner{
    display:grid; grid-template-columns: 1fr 1fr; gap:56px; align-items:center;
  }
  .about-figure{
    border:1px solid var(--line); background:var(--white);
    padding:34px; position:relative;
  }
  .about-figure .icon-row{display:flex; gap:22px; margin-bottom:22px; font-size:1.6rem;}
  .about p{color:var(--slate); font-size:1.02rem; margin-top:16px;}

  /* ---- kontakt ---- */
  .kontakt{
    background:var(--ink); color:var(--paper);
  }
  .kontakt .section-head h2{color:var(--paper);}
  .kontakt .section-head p{color:#b9c2bd;}
  .kontakt-grid{display:grid; grid-template-columns:1fr 1fr; gap:56px;}
  .kontakt-info a{
    display:block; font-family:'Newsreader', serif; font-size:1.3rem; margin-bottom:10px;
    text-decoration:none; color:var(--paper); border-bottom:1px solid transparent;
  }
  .kontakt-info a:hover{border-bottom-color:var(--brass-soft);}
  .kontakt-info .zone{margin-top:26px; font-size:0.92rem; color:#b9c2bd;}
  form{display:flex; flex-direction:column; gap:14px;}
  form input, form textarea{
    background:transparent; border:1px solid #45514c; color:var(--paper);
    padding:12px 14px; font-family:'IBM Plex Sans', sans-serif; font-size:0.96rem;
    border-radius:2px;
  }
  form input::placeholder, form textarea::placeholder{color:#8a9691;}
  form button{
    background:var(--brass); color:var(--white); border:none; padding:13px 22px;
    font-size:0.98rem; cursor:pointer; border-radius:2px; align-self:flex-start; margin-top:4px;
  }

  footer{
    background:var(--ink); color:#8a9691; padding:24px 0; font-size:0.85rem;
    border-top:1px solid #33403b;
  }
  footer .wrap{display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;}

  @media (max-width: 860px){
    nav ul{display:none;}
    .menu-btn{display:block;}
    .hero-inner{grid-template-columns:1fr;}
    .warum-grid{grid-template-columns:1fr; gap:34px;}
    .service-block{grid-template-columns:1fr; gap:22px;}
    .anfahrt-inner{grid-template-columns:1fr; gap:22px;}
    .about-inner{grid-template-columns:1fr;}
    .kontakt-grid{grid-template-columns:1fr;}
    table.price td.amount, table.travel td.amount{text-align:left; padding-top:2px;}
  }

/* ---- legal pages (Impressum / Datenschutz) ---- */
.legal-hero{
  padding:70px 0 40px; border-bottom:1px solid var(--line);
}
.legal-hero h1{font-size:clamp(2rem, 3.5vw, 2.6rem);}
.legal-hero .lede{color:var(--slate); margin-top:14px; max-width:60ch;}
.legal-body{padding:56px 0 90px;}
.legal-body .wrap{max-width:760px;}
.legal-body h2{
  font-size:1.3rem; margin-top:46px; margin-bottom:14px;
  padding-top:20px; border-top:1px solid var(--line);
}
.legal-body h2:first-child{margin-top:0; border-top:none; padding-top:0;}
.legal-body p, .legal-body li{color:var(--slate); font-size:0.98rem; margin:0 0 12px;}
.legal-body strong{color:var(--ink); font-weight:500;}
.legal-body ul{margin:0 0 12px; padding-left:20px;}
.legal-body a.inline{color:var(--brass); text-decoration:underline;}
.fill{
  background:#fff8ea; border:1px dashed var(--brass-soft);
  padding:1px 8px; color:var(--brass); font-size:0.94rem; border-radius:3px;
}
.back-link{
  display:inline-block; margin-bottom:26px; font-size:0.92rem;
  text-decoration:none; color:var(--slate); border-bottom:1px solid var(--line);
}
.back-link:hover{color:var(--brass); border-bottom-color:var(--brass);}
